<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raizPerfil"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/foodmap_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="¿Cómo quieres usar FOODMAP?"
            android:textColor="@color/foodmap_texto"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="36dp"
            android:gravity="center"
            android:text="Puedes elegir una sola opción para esta cuenta."
            android:textColor="@color/foodmap_texto_secundario"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnCliente"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="🍽️  SOY CLIENTE"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:text="Encuentra lugares para comer cerca de ti."
            android:textColor="@color/foodmap_texto_secundario"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnNegocio"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="🏪  SOY NEGOCIO"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Registra tu establecimiento para que te encuentren."
            android:textColor="@color/foodmap_texto_secundario"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
