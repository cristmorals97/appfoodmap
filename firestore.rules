rules_version = '2';

// FOODMAP - reglas de Cloud Firestore (proyecto foodmap-b204d)
// Pégalas en: Firebase Console > Firestore Database > Reglas > Publicar
service cloud.firestore {
  match /databases/{database}/documents {

    // usuarios/{uid}: cada usuario solo ve y escribe SU propio perfil.
    // El tipo de perfil se elige una vez y no se puede cambiar después.
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.tipoPerfil in ['cliente', 'negocio'];

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.tipoPerfil == resource.data.tipoPerfil;

      allow delete: if false;
    }

    // negocios/{uid}: cualquier usuario autenticado puede consultarlos (el mapa),
    // pero solo el dueño crea/edita SU documento, y solo si su perfil es "negocio".
    match /negocios/{uid} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipoPerfil == 'negocio'
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.keys().hasAll(
             ['nombre', 'telefono', 'whatsapp', 'tipoComida', 'descripcion',
              'catalogo', 'usuarioId', 'latitud', 'longitud'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 80
        && request.resource.data.telefono is string
        && request.resource.data.telefono.size() <= 20
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.size() <= 20
        && request.resource.data.tipoComida is string
        && request.resource.data.tipoComida.size() <= 40
        && request.resource.data.descripcion is string
        && request.resource.data.descripcion.size() <= 600
        && request.resource.data.catalogo is string
        && request.resource.data.catalogo.size() <= 2000
        && request.resource.data.latitud is number
        && request.resource.data.longitud is number
        && request.resource.data.latitud >= -90
        && request.resource.data.latitud <= 90
        && request.resource.data.longitud >= -180
        && request.resource.data.longitud <= 180;

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Todo lo demás, cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
